@@ -0,0 +1,74 @@
+/* KOffice dual-screen display routing helper.
+ *
+ * Provides reflection-based launch-on-display for Android hidden API
+ * ActivityOptions.setLaunchDisplayId(), plus a self-healing redirect
+ * when an Activity is accidentally started on the wrong display.
+ *
+ * Pattern derived from KEMI-S1 dual-display architecture (kemi-rd/md/chip.md).
+ */
+
+package org.libreoffice.androidlib;
+
+import android.app.Activity;
+import android.app.ActivityOptions;
+import android.content.Context;
+import android.content.Intent;
+import android.hardware.display.DisplayManager;
+import android.os.Build;
+import android.util.Log;
+import android.view.Display;
+
+public final class KOfficeDualScreenHelper {
+    private static final String TAG = "KOfficeDualScreen";
+
+    private KOfficeDualScreenHelper() {}
+
+    /** Launch an Activity on the specified display using hidden API reflection. */
+    public static boolean launchOnDisplay(Context ctx, Intent intent, int targetDisplayId) {
+        if (Build.VERSION.SDK_INT < 26) return false;
+        try {
+            ActivityOptions options = ActivityOptions.makeBasic();
+            java.lang.reflect.Method m = options.getClass().getMethod(
+                "setLaunchDisplayId", int.class);
+            m.invoke(options, targetDisplayId);
+            ctx.startActivity(intent, options.toBundle());
+            Log.d(TAG, "Launched on display " + targetDisplayId);
+            return true;
+        } catch (Exception e) {
+            Log.w(TAG, "setLaunchDisplayId failed, falling back", e);
+            ctx.startActivity(intent);
+            return false;
+        }
+    }
+
+    /** If the Activity is NOT on the expected display, relaunch it there and finish. */
+    public static boolean redirectToDisplayIfNeeded(Activity activity, int expectedDisplayId) {
+        int current = activity.getWindowManager().getDefaultDisplay().getDisplayId();
+        if (current == expectedDisplayId) return false;
+
+        Log.w(TAG, "Activity on display " + current + ", redirecting to " + expectedDisplayId);
+        Intent intent = activity.getIntent();
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        launchOnDisplay(activity, intent, expectedDisplayId);
+        activity.finish();
+        return true;
+    }
+
+    /** Return the ID of the first available display that is NOT the given one. */
+    public static int getOtherDisplayId(Context ctx, int excludeDisplayId) {
+        DisplayManager dm = (DisplayManager) ctx.getSystemService(Context.DISPLAY_SERVICE);
+        for (Display d : dm.getDisplays()) {
+            if (d.getDisplayId() != excludeDisplayId
+                && d.getState() == Display.STATE_ON) {
+                return d.getDisplayId();
+            }
+        }
+        Log.w(TAG, "No other display found, staying on " + excludeDisplayId);
+        return excludeDisplayId;
+    }
+
+    /** Get current display ID for this Activity. */
+    public static int getCurrentDisplayId(Activity activity) {
+        return activity.getWindowManager().getDefaultDisplay().getDisplayId();
+    }
+}
diff --git a/android/lib/src/main/java/org/libreoffice/androidlib/KOfficeImeProxyActivity.java b/android/lib/src/main/java/org/libreoffice/androidlib/KOfficeImeProxyActivity.java
