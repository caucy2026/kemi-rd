@@ -0,0 +1,143 @@
+/* KOffice cross-display IME proxy.
+ *
+ * When LOActivity is on display X, this proxy Activity is launched on the
+ * opposite display.  It hosts a transparent EditText that captures IME input
+ * and forwards committed text to the editor's WebView JS interface.
+ *
+ * Pattern derived from KEMI RustDesk KeyboardProxyManager (kemi-rd/md/cross-display-keyboard.md).
+ */
+
+package org.libreoffice.androidlib;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Build;
+import android.os.Bundle;
+import android.text.InputType;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.view.inputmethod.InputMethodManager;
+import android.widget.EditText;
+
+public class KOfficeImeProxyActivity extends Activity {
+    private static final String TAG = "KOfficeImeProxy";
+    public static final String ACTION_SEND_TEXT = "org.kemi.koffice.IME_TEXT";
+    public static final String EXTRA_TEXT = "text";
+    public static final String EXTRA_KEYCODE = "keycode";
+    public static final String EXTRA_EDITOR_DISPLAY = "editor_display";
+
+    private EditText mProxyEdit;
+    private InputMethodManager mImm;
+    private int mEditorDisplayId = -1;
+    private boolean mImeVisible = false;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        mEditorDisplayId = getIntent().getIntExtra(EXTRA_EDITOR_DISPLAY, -1);
+        Log.d(TAG, "Proxy created for editor on display " + mEditorDisplayId);
+
+        // Transparent, no UI, no touch interception
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE);
+
+        mProxyEdit = new EditText(this);
+        mProxyEdit.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
+        mProxyEdit.setImeOptions(EditorInfo.IME_FLAG_NO_FULLSCREEN);
+        mProxyEdit.setVisibility(View.VISIBLE);
+        mProxyEdit.setAlpha(0.01f); // nearly invisible but still touchable
+        mProxyEdit.setTextSize(1);
+
+        // Custom InputConnection that forwards text
+        mProxyEdit.setOnEditorActionListener((v, actionId, event) -> {
+            if (actionId == EditorInfo.IME_ACTION_DONE) {
+                closeImeAndFinish();
+                return true;
+            }
+            return false;
+        });
+
+        setContentView(mProxyEdit);
+        mImm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+
+        Log.d(TAG, "Opening IME on display " + getDisplay().getDisplayId());
+        openIme();
+    }
+
+    /** Open the IME on this proxy. */
+    public void openIme() {
+        mProxyEdit.requestFocus();
+        mProxyEdit.postDelayed(() -> {
+            mImm.showSoftInput(mProxyEdit, InputMethodManager.SHOW_IMPLICIT);
+            mImeVisible = true;
+            Log.d(TAG, "IME opened");
+        }, 200);
+    }
+
+    /** Forward committed text to the editor. */
+    private void sendTextToEditor(String text) {
+        Intent intent = new Intent(ACTION_SEND_TEXT);
+        intent.putExtra(EXTRA_TEXT, text);
+        sendBroadcast(intent);
+        Log.d(TAG, "Sent text to editor: " + text);
+    }
+
+    /** Forward key event to the editor. */
+    private void sendKeyToEditor(int keyCode) {
+        Intent intent = new Intent(ACTION_SEND_TEXT);
+        intent.putExtra(EXTRA_KEYCODE, keyCode);
+        sendBroadcast(intent);
+    }
+
+    /** Close IME and destroy this proxy. */
+    private void closeImeAndFinish() {
+        if (mImm != null && mProxyEdit != null) {
+            mImm.hideSoftInputFromWindow(mProxyEdit.getWindowToken(), 0);
+        }
+        mImeVisible = false;
+        Log.d(TAG, "IME closed, finishing proxy");
+        finish();
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        // Forward hardware keyboard events
+        if (keyCode == KeyEvent.KEYCODE_BACK) {
+            closeImeAndFinish();
+            return true;
+        }
+        sendKeyToEditor(keyCode);
+        return super.onKeyDown(keyCode, event);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mImeVisible) {
+            closeImeAndFinish();
+        }
+    }
+
+    public static void launchForEditor(Context ctx, int editorDisplayId) {
+        int proxyDisplay = KOfficeDualScreenHelper.getOtherDisplayId(ctx, editorDisplayId);
+        if (proxyDisplay == editorDisplayId) {
+            Log.w(TAG, "No other display available for IME proxy");
+            return;
+        }
+
+        Intent intent = new Intent(ctx, KOfficeImeProxyActivity.class);
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_NO_ANIMATION);
+        intent.putExtra(EXTRA_EDITOR_DISPLAY, editorDisplayId);
+
+        KOfficeDualScreenHelper.launchOnDisplay(ctx, intent, proxyDisplay);
+        Log.d(TAG, "Launching IME proxy on display " + proxyDisplay + " for editor on " + editorDisplayId);
+    }
+}
